# Copy to .env (git-ignored). Never commit real values.
# Canonical state root shared by all worktrees (ADR-008). Default: <repo>/state
PROBCAST_HOME=
# SEC EDGAR fair-access policy requires a descriptive User-Agent with a contact address.
# Use a project mailbox you control — never a personal address in code.
SEC_USER_AGENT="ProbCast research project contact@example.org"
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (needed for ALFRED vintages)
FRED_API_KEY=
# Optional, for price reconciliation (https://www.tiingo.com)
TIINGO_API_KEY=
