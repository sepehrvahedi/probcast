// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`VerdictCard template (ux-spec §7.3) > case 1 · A at 21 sessions 1`] = `"● A · Strong evidence. At 1M (21 sessions), CRPS skill against the CAPM anchor is +4.6% [+1.8, +7.4] (90% CI, n_eff ≈ 311). This is consistent with real skill against the anchor at this horizon. Against the hist_drift yardstick (survivor-biased) it is +1.0% [−2.0, +4.0]. 80% intervals contained the outcome in 78% of cases (target 80%). Pre-registered criterion (IC-004): met. Trials: 3 for this analyzer, 7 in family macro.fx, 41 team-wide. Minimum detectable skill at this sample size: ±3.1%. Holdout (outcomes ≥ 2021): sealed until 1 Dec 12:00 UK."`;

exports[`VerdictCard template (ux-spec §7.3) > case 2 · B at 63 1`] = `"◐ B · Moderate evidence. At 3M (63 sessions), CRPS skill against the CAPM anchor is +5.1% [+0.3, +10.0] (90% CI, n_eff ≈ 104). This is consistent with real skill against the anchor at this horizon. Against the hist_drift yardstick (survivor-biased) it is +1.0% [−2.0, +4.0]. 80% intervals contained the outcome in 78% of cases (target 80%). Pre-registered criterion (IC-007): met. Trials: 3 for this analyzer, 7 in family macro.fx, 41 team-wide. Minimum detectable skill at this sample size: ±3.1%. Holdout (outcomes ≥ 2021): sealed until 1 Dec 12:00 UK."`;

exports[`VerdictCard template (ux-spec §7.3) > case 3 · C with the CI including 0 at 63 1`] = `"◔ C · Weak evidence. At 3M (63 sessions), CRPS skill against the CAPM anchor is +2.0% [−1.0, +5.0] (90% CI, n_eff ≈ 104). This is not distinguishable from the CAPM anchor. Against the hist_drift yardstick (survivor-biased) it is +1.0% [−2.0, +4.0]. 80% intervals contained the outcome in 78% of cases (target 80%). Pre-registered criterion (IC-007): not met. Trials: 3 for this analyzer, 7 in family macro.fx, 41 team-wide. Minimum detectable skill at this sample size: ±3.1%. Holdout (outcomes ≥ 2021): sealed until 1 Dec 12:00 UK."`;

exports[`VerdictCard template (ux-spec §7.3) > case 4 · D with n_eff 15 at 252 1`] = `"○ D · Insufficient evidence. At 12M (252 sessions), CRPS skill against the CAPM anchor is +2.6% [−10.0, +15.0] (90% CI, n_eff ≈ 15). Fewer than 20 independent outcomes, so no test is reported. Against the hist_drift yardstick (survivor-biased) it is +1.0% [−2.0, +4.0]. 80% intervals contained the outcome in 78% of cases (target 80%). Pre-registered criterion (IC-009): not evaluable (needs n_eff ≥ 20). Trials: 3 for this analyzer, 7 in family macro.fx, 41 team-wide. Minimum detectable skill at this sample size: ±3.1%. Holdout (outcomes ≥ 2021): sealed until 1 Dec 12:00 UK."`;

exports[`VerdictCard template (ux-spec §7.3) > case 5 · D + ⊘ at 21 1`] = `"○ D · ⊘ Worse than the CAPM anchor. At 1M (21 sessions), CRPS skill against the CAPM anchor is −4.2% [−7.0, −1.4] (90% CI, n_eff ≈ 311). Forecasts were worse than the CAPM anchor at this horizon. Against the hist_drift yardstick (survivor-biased) it is +1.0% [−2.0, +4.0]. 80% intervals contained the outcome in 78% of cases (target 80%). Pre-registered criterion (IC-005): not met. Trials: 3 for this analyzer, 7 in family macro.fx, 41 team-wide. Minimum detectable skill at this sample size: ±3.1%. Holdout (outcomes ≥ 2021): sealed until 1 Dec 12:00 UK."`;

exports[`VerdictCard template (ux-spec §7.3) > case 6 · XBRL-era analyzer at 252, n_eff ≈ 6 1`] = `"○ D · Insufficient evidence. At 12M (252 sessions) there are too few independent outcomes to estimate skill (n_eff ≈ 6; the minimum is 10). Pre-registered criterion (IC-011): not evaluable (needs n_eff ≥ 20). Trials: 3 for this analyzer, 7 in family macro.fx, 41 team-wide. Holdout (outcomes ≥ 2021): sealed until 1 Dec 12:00 UK."`;
