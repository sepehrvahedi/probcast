    "id": "IC-004",
    "title": "Real-yield sensitivity",
    "author": "osprey",
    "report_section": "macro",
    "course_concepts": ["interest rates", "CAPM/beta"],
    "hypothesis": "When the 10-year real yield has risen over the last quarter, DEMO's 6M return is lower than its CAPM expectation.",
    "rationale": "Long-duration equity cash flows are discounted at higher real rates. Counter-argument: the CAPM anchor already includes the risk-free rate.",
    "data_needed": ["FRED:DFII10 — market_observable (same_session_close): daily, next morning"],
    "rule": "63-session change in the 10-year TIPS yield as of each origin.",
    "parameters": {
      "sessions": [63]
    },
    "horizons": [126],
    "expected_direction": "lower; about −3% over six months",
    "success_criterion": "Beats the CAPM anchor on CRPS at 126 sessions with grade ≥ C.",
    "drop_if": "CRPSS 90% CI entirely below zero at 126 sessions.",
    "references": [
      "Campbell, J.Y. and Ammer, J. (1993) 'What moves the stock and bond markets?', Journal of Finance, 48(1), pp. 3–37."
