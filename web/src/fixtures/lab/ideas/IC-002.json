  "card": {
    "id": "IC-002",
    "title": "Earnings yield vs own history",
    "author": "wren",
    "report_section": "fundamental",
    "course_concepts": ["valuation/DCF", "EMH"],
    "hypothesis": "When the earnings yield is in the top tercile of its own past values, DEMO's 12M return is higher than its CAPM expectation.",
    "rationale": "Cheap valuations relative to history may mean-revert. The market may already price this. Counter-argument: low prices can reflect lower expected growth.",
    "data_needed": [
      "10-K/10-Q diluted EPS — sec_filing (acceptance_then_first_close): on the SEC acceptance time",
      "prices — exchange_price (same_session_close): at each close"
    ],
    "rule": "TTM diluted EPS divided by the as-of close; tercile cut-offs from past values only (expanding window).",
    "parameters": {
      "terciles": [3]
    },
    "horizons": [252],
    "expected_direction": "higher; about +4% over 12 months",
    "success_criterion": "80% intervals cover 70–90% at 252 sessions; descriptive role otherwise.",
    "drop_if": "Coverage outside 60–95% at 252 sessions.",
    "references": [
      "Campbell, J.Y. and Shiller, R.J. (1988) 'Stock prices, earnings, and expected dividends', Journal of Finance, 43(3), pp. 661–676."
