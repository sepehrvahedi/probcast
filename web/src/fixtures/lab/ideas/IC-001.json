  "card": {
    "id": "IC-001",
    "title": "USD index sensitivity",
    "author": "heron",
    "report_section": "macro",
    "course_concepts": ["FX exposure", "CAPM/beta"],
    "hypothesis": "When the USD index has risen over the last 13 weeks, DEMO's 3M return is lower than its CAPM expectation.",
    "rationale": "Foreign revenue converts at a weaker rate, so reported earnings fall with a lag. Analysts adjust slowly to translation effects. Counter-argument: the company hedges part of its exposure.",
    "data_needed": [
      "FRED:DTWEXBGS — constructed_weekly (alfred_realtime_start): published weekly (H.10)"
    ],
    "rule": "13-week log change in the USD index as of each origin close; sign of the change selects the bucket.",
    "parameters": {
      "lookback_weeks": [13, 8, 26]
    },
    "horizons": [63],
    "expected_direction": "lower; about −2% over a quarter",
    "success_criterion": "Beats the CAPM anchor on CRPS at 63 sessions with grade ≥ B and 80% intervals covering 70–90%.",
    "drop_if": "CRPSS 90% CI entirely below zero at 63 sessions.",
    "references": [
      "Jorion, P. (1990) 'The exchange-rate exposure of U.S. multinationals', Journal of Business, 63(3), pp. 331–345."
    ],
    "holdout_ack": true,
